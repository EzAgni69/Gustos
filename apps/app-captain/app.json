{
  "expo": {
    "name": "Gusto Captain",
    "slug": "gusto-captain",
    "version": "0.0.1",
    "orientation": "portrait",
    "scheme": "gusto-captain",
    "platforms": [
      "ios",
      "android"
    ],
    "userInterfaceStyle": "dark",
    "backgroundColor": "#09090b",
    "icon": "./assets/images/icon.png",
    "ios": {
      "bundleIdentifier": "com.gusto.captain",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Gusto Captain connects to the local POS server over Wi-Fi.",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      }
    },
    "android": {
      "package": "com.gusto.captain",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#09090b"
      }
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#09090b"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "43fa6459-fc31-4a7e-9998-6895fc7a3009"
      }
    }
  }
}
