{
  "name": "@gusto/app-captain",
  "version": "0.0.1",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "build": "echo 'Use EAS Build for production builds'",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "clean": "rm -rf .expo .turbo",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "eas-build-post-install": "pnpm --filter @gusto/api-contracts build && pnpm --filter @gusto/printer build && pnpm --filter @gusto/core-logic build"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/metro-runtime": "~57.0.17",
    "@expo/vector-icons": "^15.1.1",
    "@gusto/api-contracts": "workspace:*",
    "@gusto/core-logic": "workspace:*",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "^9.1.0",
    "expo": "~57.0.31",
    "expo-build-properties": "~57.0.22",
    "expo-constants": "~57.0.22",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.13",
    "expo-network": "^57.0.3",
    "expo-router": "~57.0.29",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "react": "^19.2.3",
    "react-dom": "19.2.3",
    "react-native": "~0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "~4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-worklets": "0.10.1",
    "socket.io-client": "^4.8.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@gusto/tsconfig": "workspace:*",
    "@types/react": "^19.2.17",
    "babel-preset-expo": "^57.0.16",
    "hermes-parser": "^0.37.0",
    "typescript": "^6.0.3"
