# ─── Cloud Database (PostgreSQL) ───
DATABASE_URL=postgresql://gusto:gusto_dev_password@localhost:5432/gusto_dev

# ─── Redis (BullMQ / Sync Worker) ───
REDIS_URL=redis://localhost:6379

# ─── JWT Auth ───
JWT_SECRET=change-me-in-production
JWT_EXPIRY=7d

# ─── Local POS Config ───
POS_LOCAL_PORT=8080
POS_LOCAL_DB_PATH=./data/local.sqlite

# ─── Cloud API ───
API_GATEWAY_PORT=3001
API_GATEWAY_URL=http://localhost:3001

# ─── Web Admin ───
WEB_ADMIN_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3001

# ─── Sync Worker ───
SYNC_WORKER_CONCURRENCY=5

