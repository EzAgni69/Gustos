# ─── Cloud Database (PostgreSQL) ───
DATABASE_URL=postgresql://gusto:gusto_dev_password@localhost:5432/gusto_dev

# ─── Redis (BullMQ / Sync Worker) ───
REDIS_URL=redis://localhost:6379

# ─── JWT Auth ───
JWT_SECRET=change-me-in-production
JWT_EXPIRY=7d

# ─── Local POS Config ───
POS_LOCAL_PORT=8080
POS_LOCAL_DB_PATH=./data/local.sqlite
ORGANIZATION_ID=00000000-0000-0000-0000-000000000001
OUTLET_ID=00000000-0000-0000-0000-000000000003

# ─── Bill Printers ───
# POS admin / desktop cable printer. Use QUEUE for an OS printer queue, or DEVICE for a raw USB device path.
# POS_BILL_PRINTER_MODE=system
# POS_BILL_PRINTER_QUEUE=Gustos_USB_Printer
# POS_BILL_PRINTER_DEVICE=/dev/usb/lp0

# Captain app / WiFi thermal printer reachable from the POS local server LAN.
# CAPTAIN_BILL_PRINTER_MODE=network
# CAPTAIN_BILL_PRINTER_HOST=192.168.1.50
# CAPTAIN_BILL_PRINTER_PORT=9100

# ─── Cloud API ───
API_GATEWAY_PORT=3001
API_GATEWAY_URL=http://localhost:3001

# ─── Web Admin ───
WEB_ADMIN_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# ─── Frontends (Vite / React Native) ───
VITE_API_URL=http://localhost:8080/api
EXPO_PUBLIC_API_URL=http://192.168.1.102:8080/api # Must be actual network IP for mobile apps

# ─── Sync Worker ───
SYNC_WORKER_CONCURRENCY=5

# ─── Integrations (Phase 5) ───
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# ZOMATO_WEBHOOK_SECRET=
# MSG91_AUTH_KEY=
# TALLY_EXPORT_PATH=
