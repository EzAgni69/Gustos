# ════════════════════════════════════════════════════════════════════
#  Gusto ERP — environment template
#  Copy to .env and fill in. Never commit the real .env.
#  [cloud] = API gateway / sync worker   [pos] = outlet POS server
# ════════════════════════════════════════════════════════════════════

# development | production. Production turns on the strict security checks:
# the gateway refuses to start with a weak JWT_SECRET and refuses POS sync
# without a POS API key.
NODE_ENV=development

# ─── [cloud] Database & Redis ───
# docker-compose.yml publishes Postgres on host port 5433.
DATABASE_URL=postgresql://gusto:gusto_dev_password@localhost:5433/gusto_dev
REDIS_URL=redis://localhost:6379

# ─── [cloud] Auth ───
# REQUIRED in production: at least 32 random characters.  openssl rand -hex 32
JWT_SECRET=change-me-in-production
JWT_EXPIRY=7d
# Set to true once your organization exists, to close public sign-up.
# DISABLE_REGISTRATION=true

# ─── [cloud] Web ───
API_GATEWAY_PORT=3001
# Comma-separated list of browser origins allowed to call the API.
# CORS_ORIGIN=https://admin.example.com
# TRUST_PROXY=true
LOG_LEVEL=info

# ─── [cloud + pos] POS ↔ cloud authentication ───
# The same value must be set on the cloud and on the outlet's POS server.
# REQUIRED in production.  openssl rand -hex 24
# POS_API_KEY=
# Multi-outlet: one key per outlet, each valid only for its own outlet
# (cloud side; each POS still sets its own key as POS_API_KEY).
# POS_OUTLET_API_KEYS=<outlet-uuid>=<key>,<outlet-uuid>=<key>
# Development escape hatch — accepts unauthenticated POS sync. Never in production.
# ALLOW_INSECURE_POS_SYNC=true

# ─── [pos] Outlet identity & cloud link ───
POS_LOCAL_PORT=8080
POS_LOCAL_DB_PATH=./data/local.sqlite
ORGANIZATION_ID=00000000-0000-0000-0000-000000000001
OUTLET_ID=00000000-0000-0000-0000-000000000003
API_GATEWAY_URL=http://localhost:3001
# Set to false to run an outlet fully standalone (no cloud).
# CLOUD_SYNC_ENABLED=true
# CLOUD_SYNC_INTERVAL_MS=60000
# SYNC_OUTBOX_RETENTION_DAYS=7

# ─── [pos] Staff sessions ───
# Staff sign in with name + PIN and get a signed session token.
# The signing secret is generated and stored in the local database; set this
# only if you need to pin it.
# POS_SESSION_SECRET=
# POS_SESSION_TTL_HOURS=168
# Accept the old X-User-Id header from Captain / POS builds made before
# session tokens. Insecure — use only while rolling out updated apps.
# POS_ALLOW_LEGACY_AUTH=true

# ─── [pos] Printers ───
# MODE: network | system | device | preview (console). Unset = preview.
# Billing counter printer
# POS_BILL_PRINTER_MODE=network
# POS_BILL_PRINTER_HOST=192.168.1.200
# POS_BILL_PRINTER_PORT=9100
# POS_BILL_PRINTER_QUEUE=Gustos_USB_Printer
# POS_BILL_PRINTER_DEVICE=/dev/usb/lp0
# Captain app / floor printer
# CAPTAIN_BILL_PRINTER_MODE=network
# CAPTAIN_BILL_PRINTER_HOST=192.168.1.50
# CAPTAIN_BILL_PRINTER_PORT=9100
# Kitchen ticket printer (falls back to the billing printer when unset).
# New KOTs print automatically when a kitchen printer is configured;
# force with KOT_AUTO_PRINT=true / false.
# KITCHEN_PRINTER_MODE=network
# KITCHEN_PRINTER_HOST=192.168.1.201
# KITCHEN_PRINTER_PORT=9100
# KOT_AUTO_PRINT=true
# A kitchen ticket that could not print within this window is dropped.
# KOT_PRINT_MAX_AGE_MINUTES=20

# ─── [pos] Online orders ───
# Accept aggregator orders and fire the KOT without waiting for staff.
# AUTO_KOT_ONLINE_ORDERS=false

# ─── Frontends ───
WEB_ADMIN_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
VITE_API_URL=http://localhost:8080/api
# Must be the POS machine's LAN IP for phones
EXPO_PUBLIC_API_URL=http://192.168.1.102:8080/api

# ─── [cloud] Workers & monitoring ───
SYNC_WORKER_CONCURRENCY=5
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.1
